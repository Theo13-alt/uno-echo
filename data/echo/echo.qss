QWidget { background: #141217; color: #d4cfd8; font-family: "Inter"; font-size: 13px; }
QLabel { background: transparent; }
QLabel#brand { font-family: "Jura"; font-size: 26px; color: #d8d1dd; }
QPushButton#aboutButton { background: transparent; border: none; padding: 2px; min-height: 0; }
QPushButton#aboutButton:hover, QPushButton#aboutButton:focus { background: #211c29; border: 1px solid #805fd1; }
QTextBrowser { background: #141217; border: none; }
QLineEdit { background: #211c29; border: 1px solid #3a3444; border-radius: 6px; padding: 9px 12px; selection-background-color: #6041ad; }
QLineEdit:focus { border-color: #805fd1; }
QLabel#serverError { color: #e1b665; }
QLabel#status { color: #aaa3b0; font-size: 12px; }
QLabel#shortcut { background: #211c29; color: #9b7be8; padding: 7px 10px; border-radius: 6px; }
QTextEdit { background: #111014; border: 1px solid #25222a; border-radius: 8px; padding: 12px; selection-background-color: #6041ad; font-size: 14px; }
QComboBox, QPushButton { background: #211c29; border: 1px solid #3a3444; border-radius: 6px; min-height: 24px; padding: 5px 12px; }
QComboBox:hover, QPushButton:hover { background: #382d49; border-color: #805fd1; }
QPushButton:disabled { color: #8d8794; background: #18151c; border-color: #25222a; }
QPushButton#insert { background: #6041ad; border-color: #805fd1; }
QPushButton#insert:hover { background: #805fd1; }
QPushButton#insert:disabled { background: #211c29; border-color: #2c2832; color: #8d8794; }
QComboBox { padding-right: 28px; combobox-popup: 0; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url(:/echo/chevron-down.svg); width: 12px; height: 12px; }
QComboBox QAbstractItemView { background: #211c29; border: 1px solid #3a3444; border-radius: 6px; padding: 4px; outline: none; selection-background-color: #382d49; }
QComboBox QAbstractItemView::item { padding: 8px 12px; border-radius: 6px; }
QComboBox QAbstractItemView::item:hover, QComboBox QAbstractItemView::item:selected { background: #382d49; }
QScrollBar:vertical { background: #111014; width: 10px; }
QScrollBar::handle:vertical { background: #3a3444; border: 2px solid #111014; border-radius: 5px; min-height: 28px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QMenu { background: #211c29; border: 1px solid #3a3444; padding: 4px; }
QMenu::item { padding: 8px 20px; }
QMenu::item:selected { background: #382d49; }
